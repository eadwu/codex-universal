FROM nvidia/cuda:13.4.2-cudnn-devel-ubuntu26.04

RUN apt update && \
    apt install -y \
        python3 \
        git \
        git-lfs \
        && \
    apt install -y \
        build-essential \
        git \
        git-lfs \
        cmake \
        libx11-dev \
        libxxf86vm-dev \
        libxcursor-dev \
        libxi-dev \
        libxrandr-dev \
        libxinerama-dev \
        libxkbcommon-dev \
        libwayland-dev \
        wayland-protocols \
        libdbus-1-dev \
        libgl-dev \
        libegl-dev \
        && \
    apt install -y \
        ninja-build \
        cmake-curses-gui \
        cmake-gui \
        patch \
        libjack-jackd2-dev \
        libpulse-dev \
        libpipewire-0.3-dev \
        && \
    rm -rf /var/lib/apt/lists/* 

RUN mkdir -p /blender.git && \
    git clone https://projects.blender.org/blender/blender.git --branch v5.3.0 /blender.git/blender && cd /blender.git/blender && \
    python3 ./build_files/linux/install_linux_packages.py && \
    make update && \
    make
